# Copy to .env and fill in only what you use. .env is gitignored.

# Optional. Without it JobPilot uses its local (free) matcher.
ANTHROPIC_API_KEY=

# Optional, for the USAJOBS source (free key from developer.usajobs.gov).
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Where personal data lives. Defaults to ./data
# JOBPILOT_HOME=
