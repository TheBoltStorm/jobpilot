{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "0.2.0",
  "description": "Fill job applications from your local JobPilot profile. Shows every value first. Never submits.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot: fill this application"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.workable.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Open JobPilot on this page"
    }
  }
}
